<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent surface behind the alert body text. Gives the long-form
     alert content a discrete container so it doesn't bleed into the
     gradient + competes less with the headline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#22000000" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="18dp" />
</shape>
