<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical gradient backdrop for the takeover. Top crimson → bottom
     deep maroon adds depth without distracting from the text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#5C0000"
        android:startColor="#D80F0F"
        android:type="linear" />
</shape>
