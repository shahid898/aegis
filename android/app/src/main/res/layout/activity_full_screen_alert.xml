<?xml version="1.0" encoding="utf-8"?>
<!--
  Lock-screen takeover layout for FullScreenAlertActivity.
  Goals:
    - Read at a glance under stress / poor lighting.
    - Clear hierarchy: pulsing icon → eyebrow → body → countdown → CTA.
    - Two-button row so a panicked tap doesn't accidentally dismiss.
    - All copy backed by `@string/` resources so it follows Android's
      system locale; the body itself is injected per-alert from Kotlin.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alert_gradient_bg"
    android:keepScreenOn="true">

    <!-- Top safety inset + eyebrow -->
    <TextView
        android:id="@+id/alert_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/alert_eyebrow_pill"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.18"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/alert_eyebrow"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pulsing alert icon. Background = white halo, foreground = warning glyph.
         The pulse animation is attached in Kotlin via ObjectAnimator so it can
         be cancelled when the activity is dismissed. -->
    <FrameLayout
        android:id="@+id/alert_icon_halo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/alert_icon_halo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alert_eyebrow">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@string/alert_eyebrow"
            android:src="@android:drawable/ic_dialog_alert"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/alert_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:lineSpacingMultiplier="1.05"
        android:text="@string/alert_title"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alert_icon_halo" />

    <TextView
        android:id="@+id/alert_sender"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="#FFE0E0"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alert_title" />

    <!-- Body text inside a translucent surface so it stays legible against
         the gradient. Capped height + scroll so a long alert body never
         pushes the CTA off-screen. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/alert_body_surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/alert_body_surface"
        android:fillViewport="false"
        android:padding="18dp"
        app:layout_constraintBottom_toTopOf="@id/alert_auto_open_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alert_sender"
        app:layout_constraintVertical_bias="0">

        <TextView
            android:id="@+id/alert_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/alert_auto_open_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/alert_eyebrow_pill"
        android:drawableStart="@android:drawable/ic_menu_recent_history"
        android:drawablePadding="8dp"
        android:drawableTint="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/alert_button_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Two-button row. Primary CTA matches the takeover's natural intent
         (open the app to act on the alert). Dismiss is outlined + secondary
         so a panicked tap doesn't accidentally suppress a real emergency. -->
    <LinearLayout
        android:id="@+id/alert_button_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/alert_dismiss"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/alert_button_outlined"
            android:fontFamily="sans-serif-medium"
            android:text="@string/alert_dismiss"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/alert_open_now"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.4"
            android:background="@drawable/alert_button_primary"
            android:fontFamily="sans-serif-black"
            android:text="@string/alert_open_now"
            android:textColor="#B30000"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
